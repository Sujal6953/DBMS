#table creation
create table department01(
DNO number(4) constraint d1 primary key,
DNAME varchar2(30) constraint d2 not null,
MGRSSN number(4),
MGRSTARTDATE date);

desc department01;

create table employee01(
SSN number(4) constraint e1 primary key,
FNAME varchar2(30),
MINT varchar2(30),
LNAME varchar2(30),
BDATE date,
ADDRESS varchar2(50),
SEX varchar(10),
SALARY number(10,2),
SUPERSSN number(4),
DNO number(4) constraint e2 references department01(DNO));

desc employee01;

create table deptlocations01(
DNO number(4) constraint dd1 references department01(DNO),
DLOCATION varchar2(30));

desc deptlocations01;

create table project01(
PNUMBER number(4) constraint p1 primary key,
PNAME varchar2(30) constraint p2 not null,
PLOCATION varchar2(50),
DNO number(4) constraint p3 references Department01(DNO));

desc project01;

create table workson01(
ESSN number(4) constraint w1 references employee01(SSN),
PNUMBER number(4) constraint w2 references project01(PNUMBER),
HOURS number(4));

desc workson01;

create table dependent01(
ESSN number(4) constraint ddd1 references employee01(SSN),
DEPENDENTNAME varchar2(40),
SEX varchar2(20),
BDATE date,
RELATIONSHIP varchar2(50));

desc dependent01;

