#queries
select sum(salary), max(salary), min(salary), avg (salary) from employee01;

select count(*) from employee01;

select count(*) from employee01 where DNO =
( Select DNO from department01 where DNAME = 'Research')
 group by DNO;

Select DNO, avg(salary), count(*) from employee01 group by dno;

Select DNO, avg(Salary) from employee01 group by dno having avg(salary)>20000;

select SSN, Salary, (Salary*10)/100+salary from employee01, department01 where 
employee01.dno = department01.dno and dname = 'Research';

select sum(salary), avg(salary), max(salary), min(salary) from employee01, department01 where
employee01.dno=department01.dno and dname='Accounts';

select fname,mint,lname from employee01 where exists
(select pnumber from project01 where dno=5 and pnumber in 
(select pno from workson01 where essn = ssn));

select dname, count(*) from employee01, department01 where 
employee01.dno = department01.dno group by
dname having count(*)> =2;

select pnumber, pname, count(*) from project01, workson01 where 
project01.pnumber = workson01.pno group by pnumber, pname;

select fname, mint, lname from employee01 where 
to_char(bdate,'YYYY') like '%1990';

select dname,count(*) from employee01, department01 where 
employee01.dno=department01.dno and
salary>40000 group by dname having count(*)>=2;

select pnumber,pname, count(*) from project01, workson01 where
project01.pnumber = workson01.pno group by pnumber, pname having count(*)>2;

create view v1 as 
(select fname, mint, lname, pname, hours from employee01, workson01, project01 where
employee01.ssn = workson01.essn and project01.pnumber = workson01.pno);

select * from v1 where hours>10;

