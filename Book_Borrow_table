#queries
Select * from student001 where 
sem=2 and Branch_Id = 
(Select Branch_Id from branch001 where
Branch_Name = 'MCA');

Select * from student001 where USN not in (select USN from Borrow001);

Select student001.USN, student001.Name, branch001.Branch_Name, book001.Book_Name, author001.Author_Name, borrow001.Borrowed_Date
from student001, branch001, book001, author001, borrow001 
where student001.Branch_Id = branch001.Branch_Id and 
book001.Author_Id = author001.Author_Id and
borrow001.USN = student001.USN and 
borrow001.Book_Id = book001.Book_Id and
sem=2 and
branch001.Branch_Name = 'MCA';

Select Author_Id, count(*) from book001 group by Author_id;

Select * from student001 where USN in
(Select USN from borrow001 group by USN having count(*)>=2);

Select * from student001 where exists 
(Select USN from borrow001, Book001 where 
book001.Book_Id = Borrow001.Book_Id and 
student001.USN  = borrow001.USN group by 
USN having count (distinct Author_Id) > 1);

Select Book_Name from Book001 order by Book_Name desc;
