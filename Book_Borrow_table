create table branch001 ( 
Branch_Id number(4) constraint b1 primary key,
Branch_Name varchar(230) constraint b2 not null,
HOD varchar2(40));

create table author001(
Author_Id number(4) constraint a1 primary key,
Author_Name varchar2(30) constraint a2 not null,
Country varchar2(20),
Age number(3));

create table student001(
USN varchar2(10) constraint s1 primary key,
Name varchar2(20) constraint s2 not null,
Address varchar2(30),
Branch_Id number(4) constraint s3 references branch001(Branch_Id),
sem number(2));

create table book001(
Book_Id number(4) constraint bb1 primary key,
Book_Name varchar2(40) constraint bb2 not null,
Author_Id number(4) constraint bb3 references author001(Author_Id),
Publisher varchar2(30),
Branch_Id number(4) constraint bb4 references branch001(Branch_Id));

create table borrow001(
USN varchar2(10) constraint bbb1 references student001(USN),
Book_Id number(4) constraint bbb2 references book001(Book_Id),
Borrowed_Date date,
constraint bbb3 primary key(USN,Book_Id));

