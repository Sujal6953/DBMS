#Table creation
create table student01 (
USN varchar2(10) constraint ss1 primary key,
Name varchar2(50) constraint ss2 not null,
DOB date,
Branch varchar2(30),
m1 number(3) constraint ss3 check (m1>=0),
m2 number(3) constraint ss4 check (m2>=0),
m3 number(3) constraint ss5 check (m3>=0),
Total number(10),
GPA number(8,2));

